# Railway/Nixpacks builds run with NODE_ENV=production, which makes `npm ci`
# omit devDependencies. But the build phase needs typescript (tsc), prisma,
# and @types/* to compile. Force dev deps to install so `npm run build` works.
# (We can't add `npm ci --include=dev` to the build command because that phase
# mounts a cache at node_modules/.cache and `npm ci` can't rmdir the mount → EBUSY.)
include=dev
